# ============================================
# Challenge Server 환경 설정 예시
# ============================================
# 실제 배포 시 이 파일을 .env로 복사하고 값을 채워주세요.
# .env는 gitignore되어 있어 비밀이 유출되지 않습니다.

# -------------------------------------------
# OIDC 인증 서버 (SSO)
# -------------------------------------------
# 서버→서버 호출에 쓰는 내부 주소 (이게 실제 OIDC provider URL)
AUTH_SERVER=https://auth.example.com
# 브라우저 리다이렉트에 쓰는 외부 주소 (보통 AUTH_SERVER와 동일)
AUTH_PUBLIC=https://auth.example.com

# -------------------------------------------
# Challenge 서버 자기 자신의 공개 주소 (OIDC callback URL 생성용)
# -------------------------------------------
CHALLENGE_HOST=http://localhost:47777
CHALLENGE_PORT=47777

# -------------------------------------------
# 강사 계정의 OIDC sub (이 값과 일치하는 유저가 강사 권한)
# -------------------------------------------
PRESENTER_SUB=admin

# -------------------------------------------
# 채점용 LLM (OpenAI 호환 API)
# -------------------------------------------
LLM_GATEWAY_URL=https://llm-gateway.example.com/v1
LLM_GATEWAY_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# -------------------------------------------
# 개발 편의
# -------------------------------------------
# DEV_MODE=true 이면 SSO 우회, 모든 요청을 관리자(admin)로 간주
DEV_MODE=false

# -------------------------------------------
# 프록시 (사내망 환경)
# -------------------------------------------
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
