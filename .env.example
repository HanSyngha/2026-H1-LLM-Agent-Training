# ============================================
# LLM Gateway 설정
# ============================================
LLM_GATEWAY_URL=http://your-gateway-host:port/v1
LLM_GATEWAY_API_KEY=your-api-key
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-ada-002

# ============================================
# 프록시 설정 (사내망)
# ============================================
HTTP_PROXY=http://your-proxy-host:8000
HTTPS_PROXY=http://your-proxy-host:8000
NO_PROXY=localhost,127.0.0.1,.your-company.net
NODE_TLS_REJECT_UNAUTHORIZED=0

# ============================================
# SSL 설정
# ============================================
# 사내 프록시 인증서 이슈로 SSL 검증 비활성화
SSL_VERIFY=false
